# === REQUIRED ===

# Telegram Bot Token — obtené el tuyo en @BotFather
TELEGRAM_TOKEN=

# DeepSeek API Key — https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=

# Google Sheet ID — el ID de tu spreadsheet (la parte larga de la URL)
GOOGLE_SHEET_ID=

# Tu chat ID de Telegram (para recibir reportes mensuales y errores)
ADMIN_CHAT_ID=

# === OPTIONAL ===

# GCP Service Account JSON — para producción en Fly.io.
# Si no está definida, el código busca service_account.json en disco.
# En Fly.io: cat service_account.json | fly secrets set GCP_SERVICE_ACCOUNT_JSON=@-
GCP_SERVICE_ACCOUNT_JSON=

# Gemini API Key — actualmente NO se usa (el bot usa DeepSeek).
# Se mantiene por compatibilidad o futura migración.
GEMINI_API_KEY=
